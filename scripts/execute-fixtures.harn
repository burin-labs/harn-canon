import { parse_args } from "std/cli"
import {
  CanonFixtureCase,
  FixtureCaseResult,
  FixturePackReport,
  FixtureRunFailure,
  expected_packs,
  fixture_verdict,
  parse_invariants,
  read_fixture_document_result,
  read_pack_manifest_result,
  repo_root,
  structured_read_failure_message,
} from "./canon-lib"

const arg_spec = [{kind: "option", name: "pack", flags: ["--pack"], multi: true, default: []}]

type FixtureHarness = {fs: HarnessFs, runtime: HarnessRuntime}

fn run_case(
  harness: FixtureHarness,
  pack: string,
  predicate: string,
  mode: string,
  case: CanonFixtureCase,
) -> FixtureCaseResult {
  const semantic_judge = { _request ->
    return {verdict: case.judge_verdict ?? case.expect, findings: []}
  }
  const eval_result = harness.runtime.flow_evaluate_invariants(
    "",
    {files: case.files},
    {
      path: path_join(repo_root(harness.fs), pack, "invariants.harn"),
      predicates: [predicate],
      include_semantic: mode == "semantic",
      budget_ms: if mode == "semantic" {
        2000
      } else {
        50
      },
      ctx: (case.ctx ?? {}) + {semantic_judge: semantic_judge},
    },
  )
  const records = eval_result?.records ?? []
  let record = nil
  for candidate in records {
    if candidate.name == predicate {
      record = candidate
    }
  }
  const actual = fixture_verdict(record ?? {})
  const expect = case.expect
  if actual == expect {
    return {kind: "pass"}
  }
  return {
    kind: "fail",
    failure: {
      kind: "case",
      pack: pack,
      predicate: predicate,
      case: case.name,
      expect: expect,
      actual: actual,
      result: record ?? eval_result,
    },
  }
}

/**
 * Execute one pack beneath an explicit canon root.
 *
 * @api_stability: internal
 * @effects: [fs.read]
 * @errors: []
 */
pub fn __run_pack_at(harness: FixtureHarness, root: string, pack: string) -> FixturePackReport {
  const invariants_path = path_join(root, pack, "invariants.harn")
  const parsed = parse_invariants(harness.fs, invariants_path, [])
  if len(parsed.errors) > 0 {
    return {
      pack: pack,
      executed: 0,
      failures: parsed.errors.map(
        { error -> {kind: "setup", source: "invariants", path: invariants_path, error: error} },
      )
        .to_list(),
    }
  }
  let executed = 0
  let failures: list<FixtureRunFailure> = []
  for entry in parsed.entries {
    const fixture_path = path_join(root, pack, "fixtures", entry.name + ".json")
    const fixture_result = read_fixture_document_result(harness.fs, fixture_path)
    if !is_ok(fixture_result) {
      failures = failures
        + [
        {
          kind: "setup",
          source: "fixture",
          path: fixture_path,
          error: structured_read_failure_message(unwrap_err(fixture_result)),
        },
      ]
      continue
    }
    const fixture = unwrap(fixture_result)
    for case in fixture.cases {
      const result = run_case(harness, pack, entry.name, entry.mode, case)
      executed = executed + 1
      if result.kind == "fail" {
        failures = failures + [result.failure]
      }
    }
  }
  return {pack: pack, executed: executed, failures: failures}
}

fn run_pack(harness: FixtureHarness, pack: string) -> FixturePackReport {
  return __run_pack_at(harness, repo_root(harness.fs), pack)
}

fn main(harness: Harness) {
  const parsed = parse_args(argv, arg_spec)
  if len(parsed?._errors ?? []) > 0 {
    harness.stdio.println(join(parsed._errors, "\n"))
    harness.runtime.exit(2)
  }
  const manifest_result = read_pack_manifest_result(harness.fs)
  if !is_ok(manifest_result) {
    harness.stdio.println(structured_read_failure_message(unwrap_err(manifest_result)))
    harness.runtime.exit(1)
  }
  const all_packs = expected_packs(unwrap(manifest_result))
  const requested = parsed?.pack ?? []
  let unknown: list<string> = []
  for pack in requested {
    if !all_packs.contains(pack) {
      unknown = unknown + [pack]
    }
  }
  if len(unknown) > 0 {
    harness.stdio.println("unknown pack(s): " + join(unknown.sort(), ", "))
    harness.runtime.exit(2)
  }
  const packs = if len(requested) > 0 {
    requested
  } else {
    all_packs
  }
  let reports: list<FixturePackReport> = []
  for pack in packs {
    reports = reports + [run_pack({fs: harness.fs, runtime: harness.runtime}, pack)]
  }
  let failures: list<FixtureRunFailure> = []
  let executed = 0
  for report in reports {
    executed = executed + report.executed
    failures = failures + report.failures
  }
  if len(failures) > 0 {
    harness.stdio.println("Canon fixture execution failed:")
    for report in reports {
      for failure in report.failures {
        harness.stdio.println("- " + report.pack + ": " + json_stringify(failure))
      }
    }
    harness.runtime.exit(1)
  }
  harness.stdio.println(
    "Executed "
      + to_string(executed)
      + " fixture cases across "
      + to_string(len(packs))
      + " packs through flow_evaluate_invariants.",
  )
}
