import { with_temp_dir } from "std/testing"
import {
  markdown_list_link_targets,
  markdown_section_lines,
  markdown_table_code_keys,
  read_fixture_document_result,
  read_pack_manifest_path_result,
} from "../scripts/canon-lib"
import { __run_pack_at } from "../scripts/execute-fixtures"
import { validate_fixture_value } from "../scripts/validate-canon"

fn write_json(fs: HarnessFs, path: string, value: unknown) -> nil {
  fs.write_text(path, json_stringify(value))
  return nil
}

fn canonical_manifest() -> dict {
  return {
    schema_version: 1,
    packs: [
      {
        id: "rust",
        title: "Rust",
        invariants: "rust/invariants.harn",
        fixtures: "rust/fixtures",
        extensions: ["rs"],
        file_names: ["cargo.toml"],
      },
    ],
  }
}

fn canonical_fixture() -> dict {
  return {
    predicate: "safe_rule",
    cases: [
      {
        name: "allows_safe_input",
        expect: "Allow",
        files: [{path: "src/main.rs", text: "fn main() {}"}],
        ctx: {mode: "test"},
      },
      {
        name: "blocks_unsafe_input",
        expect: "Block",
        files: [{path: "src/lib.rs", text: "unsafe {}"}],
      },
    ],
  }
}

@test
pipeline test_markdown_contract_extracts_exact_structural_rows(task) {
  const markdown = join(
    [
      "The text mentions hidden_rule but does not document it.",
      "",
      "## Packs",
      "",
      "- [Rust](./rust/) — Rust predicates.",
      "- malformed prose mentioning ](./not-a-link/)",
      "",
      "## Predicate coverage",
      "",
      "| Predicate | Mode |",
      "|---|---|",
      "| `safe_rule` | deterministic |",
      "",
      "### Notes",
      "",
      "| `not_a_direct_coverage_row` | prose |",
      "",
      "## Known false positives",
      "",
      "| `not_a_coverage_row` | prose |",
    ],
    "\n",
  )
  assert_eq(markdown_list_link_targets(markdown_section_lines(markdown, "## Packs")), ["./rust/"])
  assert_eq(
    markdown_table_code_keys(markdown_section_lines(markdown, "## Predicate coverage")),
    ["safe_rule"],
  )
}

@test
pipeline test_canonical_manifest_and_fixture_decode(harness: Harness, task) {
  with_temp_dir(
    harness.fs,
    { root ->
      const manifest_path = path_join(root, "manifest.json")
      const fixture_path = path_join(root, "fixture.json")
      write_json(harness.fs, manifest_path, canonical_manifest())
      write_json(harness.fs, fixture_path, canonical_fixture())
      const manifest = read_pack_manifest_path_result(harness.fs, manifest_path)
      const fixture = read_fixture_document_result(harness.fs, fixture_path)
      assert(is_ok(manifest), "canonical manifest decodes")
      assert(is_ok(fixture), "canonical fixture decodes")
      assert_eq(unwrap(manifest).packs[0]?.id, "rust")
      assert_eq(unwrap(fixture).cases.count, 2)
      assert_eq(
        validate_fixture_value("rust/fixtures/safe_rule.json", "safe_rule", unwrap(fixture)),
        [],
      )
    },
  )
}

@test
pipeline test_manifest_rejects_unknown_root_and_nested_keys(harness: Harness, task) {
  with_temp_dir(
    harness.fs,
    { root ->
      const root_unknown = canonical_manifest() + {extra: true}
      let pack_unknown = canonical_manifest()
      pack_unknown.packs[0].extra = true
      const root_path = path_join(root, "root-unknown.json")
      const pack_path = path_join(root, "pack-unknown.json")
      write_json(harness.fs, root_path, root_unknown)
      write_json(harness.fs, pack_path, pack_unknown)
      assert_eq(
        unwrap_err(read_pack_manifest_path_result(harness.fs, root_path)).kind,
        "schema_invalid",
      )
      assert_eq(
        unwrap_err(read_pack_manifest_path_result(harness.fs, pack_path)).kind,
        "schema_invalid",
      )
    },
  )
}

@test
pipeline test_manifest_rejects_wrong_nested_types(harness: Harness, task) {
  with_temp_dir(
    harness.fs,
    { root ->
      let manifest = canonical_manifest()
      manifest.packs[0].extensions = ["rs", 7]
      const path = path_join(root, "wrong-type.json")
      write_json(harness.fs, path, manifest)
      assert_eq(unwrap_err(read_pack_manifest_path_result(harness.fs, path)).kind, "schema_invalid")
    },
  )
}

@test
pipeline test_manifest_accepts_file_name_only_pack(harness: Harness, task) {
  with_temp_dir(
    harness.fs,
    { root ->
      const manifest = {
        schema_version: 1,
        packs: [
          {
            id: "metadata",
            title: "Metadata",
            invariants: "metadata/invariants.harn",
            fixtures: "metadata/fixtures",
            file_names: ["cargo.toml"],
          },
        ],
      }
      const path = path_join(root, "file-name-only.json")
      write_json(harness.fs, path, manifest)
      const decoded = read_pack_manifest_path_result(harness.fs, path)
      assert(is_ok(decoded), "file_names is a complete routing selector without extensions")
      assert_eq(unwrap(decoded).packs[0]?.file_names, ["cargo.toml"])
    },
  )
}

@test
pipeline test_fixture_rejects_invalid_expected_verdict(harness: Harness, task) {
  with_temp_dir(
    harness.fs,
    { root ->
      let fixture = canonical_fixture()
      fixture.cases[0].expect = "Maybe"
      const path = path_join(root, "invalid-expect.json")
      write_json(harness.fs, path, fixture)
      assert_eq(unwrap_err(read_fixture_document_result(harness.fs, path)).kind, "schema_invalid")
    },
  )
}

@test
pipeline test_fixture_rejects_unknown_keys_at_owned_boundaries(harness: Harness, task) {
  with_temp_dir(
    harness.fs,
    { root ->
      let root_unknown = canonical_fixture()
      root_unknown.extra = true
      let case_unknown = canonical_fixture()
      case_unknown.cases[0].extra = true
      let file_unknown = canonical_fixture()
      file_unknown.cases[0].files[0].extra = true
      const root_path = path_join(root, "root-unknown.json")
      const case_path = path_join(root, "case-unknown.json")
      const file_path = path_join(root, "file-unknown.json")
      write_json(harness.fs, root_path, root_unknown)
      write_json(harness.fs, case_path, case_unknown)
      write_json(harness.fs, file_path, file_unknown)
      assert_eq(
        unwrap_err(read_fixture_document_result(harness.fs, root_path)).kind,
        "schema_invalid",
      )
      assert_eq(
        unwrap_err(read_fixture_document_result(harness.fs, case_path)).kind,
        "schema_invalid",
      )
      assert_eq(
        unwrap_err(read_fixture_document_result(harness.fs, file_path)).kind,
        "schema_invalid",
      )
    },
  )
}

@test
pipeline test_fixture_rejects_wrong_file_field_type(harness: Harness, task) {
  with_temp_dir(
    harness.fs,
    { root ->
      let fixture = canonical_fixture()
      fixture.cases[0].files[0].text = 7
      const path = path_join(root, "wrong-file-type.json")
      write_json(harness.fs, path, fixture)
      assert_eq(unwrap_err(read_fixture_document_result(harness.fs, path)).kind, "schema_invalid")
    },
  )
}

@test
pipeline test_executor_reports_malformed_fixture_as_setup_failure(harness: Harness, task) {
  with_temp_dir(
    harness.fs,
    { root ->
      const pack_root = path_join(root, "test-pack")
      const fixtures_root = path_join(pack_root, "fixtures")
      harness.fs.mkdir(fixtures_root)
      harness.fs.write_text(
        path_join(pack_root, "invariants.harn"),
        join(
          [
            "const _EVIDENCE_TEST = [\"https://example.com/canon-test\"]",
            "",
            "@invariant",
            "@deterministic",
            "@archivist(evidence: _EVIDENCE_TEST, confidence: 1.0, source_date: \"2026-07-13\")",
            "pub fn malformed_rule(slice, ctx, repo_at_base) {",
            "  return {verdict: \"Allow\"}",
            "}",
          ],
          "\n",
        ),
      )
      write_json(
        harness.fs,
        path_join(fixtures_root, "malformed_rule.json"),
        {predicate: "malformed_rule", cases: [], extra: true},
      )
      const report = __run_pack_at({fs: harness.fs, runtime: harness.runtime}, root, "test-pack")
      assert_eq(report.executed, 0)
      assert_eq(report.failures.count, 1)
      assert_eq(report.failures[0]?.kind, "setup")
      assert_eq(report.failures[0]?.source, "fixture")
      assert_eq(report.failures[0]?.code, "schema_invalid")
      assert_eq(report.failures[0]?.path, path_join(fixtures_root, "malformed_rule.json"))
    },
  )
}

@test
pipeline test_executor_reports_malformed_invariants_as_setup_failure(harness: Harness, task) {
  with_temp_dir(
    harness.fs,
    { root ->
      const pack_root = path_join(root, "test-pack")
      const invariants_path = path_join(pack_root, "invariants.harn")
      harness.fs.mkdir(pack_root)
      harness.fs.write_text(
        invariants_path,
        "@invariant\npub fn missing_contract() -> bool { true }\n",
      )
      const report = __run_pack_at({fs: harness.fs, runtime: harness.runtime}, root, "test-pack")
      assert_eq(report.executed, 0)
      assert_eq(report.failures.count, 1)
      assert_eq(report.failures[0]?.kind, "setup")
      assert_eq(report.failures[0]?.source, "invariants")
      assert_eq(report.failures[0]?.code, "invariant_contract_invalid")
      assert_eq(report.failures[0]?.path, invariants_path)
      assert_eq(
        report.failures[0]?.detail,
        invariants_path + ": parsed 0 annotated pub fns but found 1 @invariant markers",
      )
    },
  )
}

@test
pipeline test_fixture_semantics_reject_non_normalized_paths(task) {
  const fixture = {
    predicate: "safe_rule",
    cases: [
      {
        name: "allows_safe_input",
        expect: "Allow",
        files: [{path: "../src/main.rs", text: "fn main() {}"}],
      },
      {
        name: "blocks_unsafe_input",
        expect: "Block",
        files: [{path: "src/lib.rs", text: "unsafe {}"}],
      },
    ],
  }
  const errors = validate_fixture_value("rust/fixtures/safe_rule.json", "safe_rule", fixture)
  assert_eq(errors.count, 1)
  assert_eq(
    errors[0],
    "rust/fixtures/safe_rule.json: case 0 file 0 path must be normalized and relative",
  )
}

@test
pipeline test_fixture_semantics_reject_duplicate_cases(task) {
  const fixture = {
    predicate: "safe_rule",
    cases: [
      {name: "same_case", expect: "Allow", files: [{path: "src/main.rs", text: "fn main() {}"}]},
      {name: "same_case", expect: "Warn", files: [{path: "src/lib.rs", text: "unsafe {}"}]},
    ],
  }
  const errors = validate_fixture_value("rust/fixtures/safe_rule.json", "safe_rule", fixture)
  assert_eq(errors, ["rust/fixtures/safe_rule.json: duplicate case names: same_case"])
}
